# Copy to .env.local and fill in. .env.local is gitignored.

# --- Admin -------------------------------------------------------------
# Required to open /admin. Without it the admin area stays shut.
ADMIN_PASSWORD=

# --- Student sign-in ---------------------------------------------------
# Google sign-in is configured in Supabase, not here: Authentication >
# Providers > Google, using an OAuth client from Google Cloud whose authorised
# redirect URI is <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/callback.
#
# Only addresses in this domain may book a seat. Setting it here is not enough
# on its own — the same domain is fixed in the signup hook and in a check
# constraint on profiles.email, both in supabase/migrations.
ALLOWED_EMAIL_DOMAIN=mgits.ac.in

# Public origin of this app. Supabase returns students to
# <APP_URL>/api/auth/callback, which must also be listed in Supabase under
# Authentication > URL Configuration > Redirect URLs.
APP_URL=http://localhost:3000

# --- Database (Supabase) -----------------------------------------------
# Supabase dashboard > Project Settings > API Keys.
# The publishable key is public by design: row-level security protects the
# data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret: bypasses row-level security. The admin area needs it until admins
# sign in with their own accounts, and so does `npm run check:concurrency`.
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Keepalive ---------------------------------------------------------
# Supabase pauses Free Plan projects after a week of low activity, so
# vercel.json runs /api/keepalive daily to touch the database.
#
# Set this in the Vercel project (not needed locally) and Vercel sends it as
# `Authorization: Bearer <value>` on cron requests; the route then refuses
# anyone else. Leave it unset and the route stays open — it only reads one
# public row, but setting it costs nothing.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
